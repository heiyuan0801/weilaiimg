APP_PORT=8080
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
APP_SECRET=change-this-long-random-app-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
# Optional Telegram storage. Leave empty to use local storage.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Stripe billing. Paid plans require provider price IDs and signed webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Cloudflare purge integration for public media.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Comma-separated browser origins allowed to send credentialed API requests.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Optional email/OIDC settings are configured in the admin UI and stored in PostgreSQL.
